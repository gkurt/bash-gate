{
  "name": "bash-gate",
  "version": "0.1.0",
  "description": "Static analysis of Bash commands: what they run, with which options and effects, and whether a policy allows it.",
  "keywords": [
    "agent",
    "ai",
    "allowlist",
    "ast",
    "bash",
    "command",
    "parser",
    "permissions",
    "policy",
    "security",
    "shell",
    "static-analysis"
  ],
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "files": [
    "dist",
    "src",
    "THREAT_MODEL.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "source": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc",
    "checks": "tsc && bun test",
    "prepublishOnly": "bun run checks && bun run build"
  },
  "dependencies": {
    "unbash": "6.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
