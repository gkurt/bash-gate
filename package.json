{
  "name": "bash-gate",
  "version": "0.1.1",
  "description": "Static analysis of Bash commands: what they run, with which options and effects, and whether a policy allows it.",
  "keywords": [
    "agent",
    "ai",
    "allowlist",
    "ast",
    "bash",
    "command",
    "parser",
    "permissions",
    "policy",
    "security",
    "shell",
    "static-analysis"
  ],
  "homepage": "https://github.com/gkurt/bash-gate",
  "bugs": {
    "url": "https://github.com/gkurt/bash-gate/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/bash-gate.git"
  },
  "files": [
    "dist",
    "src",
    "!src/tsconfig.json",
    "THREAT_MODEL.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "source": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc && tsc -p src",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "bun test",
    "checks": "bun check && bun typecheck && bun run test",
    "prepare": "husky",
    "tegami": "bun scripts/tegami.mts",
    "prepublishOnly": "bun run checks && bun run build"
  },
  "dependencies": {
    "unbash": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tegami": "^1.5.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
