{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    // Node for tests and scripts; bun-types only for the `bun:test` module, so `Bun.*` APIs don't typecheck.
    "types": ["node", "bun-types/test"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    // tsc never emits (noEmit), but tsdown reads `declarationMap` for .d.ts source maps; it requires `declaration`.
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
